# RPC endpoint (Anvil, local, or remote)
RPC_URL=http://127.0.0.1:8545

# Private key used by THIS CLI instance
# This identifies who you are: creator / executor / validator
PRIVATE_KEY=YOUR_PRIVATE_KEY_HERE

# Deployed DaoWork contract address
CONTRACT_ADDRESS=0xDAO_WORK_CONTRACT_ADDRESS_HERE

# Chain ID (Anvil default)
CHAIN_ID=31337
